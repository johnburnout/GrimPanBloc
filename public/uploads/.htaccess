# Dossier des photos envoyées : on ne sert que des images, jamais de code.
Options -Indexes -ExecCGI

# Tout est refusé…
<FilesMatch ".">
    Require all denied
</FilesMatch>
# … sauf les formats d'image acceptés par l'application.
<FilesMatch "(?i)\.(jpe?g|png|webp)$">
    Require all granted
</FilesMatch>

# Avec mod_php, désactive en plus l'interpréteur PHP dans ce dossier.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Photos servies directement par Apache, sans passer par Symfony : le navigateur
# doit s'en tenir au type annoncé (en-tête posé seulement si mod_headers est actif).
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
