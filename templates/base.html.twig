<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}GrimPanBloc{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('logo/favicon.svg') }}">
    <link rel="preload" href="{{ asset('fonts/bricolage-grotesque/bricolage-grotesque-latin-wght-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
<header class="entete">
    {# SVG insérés dans la page (et non en <img>) pour que le texte du logo
       utilise la police Bricolage Grotesque chargée par la page.
       Sur petit écran, le symbole seul laisse la place au menu. #}
    {% if club_logo() %}
        <img class="logo-club" src="{{ asset(club_logo()) }}" alt="{{ club_nom() ?: 'Logo du club' }}">
    {% endif %}
    <a href="{{ path('app_home') }}" class="logo" aria-label="GrimPanBloc, accueil">
        <span class="logo-complet">{{ source('@logo/logo-inverse.svg') }}</span>
        <span class="logo-symbole">{{ source('@logo/mark-inverse.svg') }}</span>
    </a>
    <nav>
        <a href="{{ path('app_home') }}">Voies</a>
        <a href="{{ path('secteur_index') }}">Secteurs</a>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin') }}">Administration</a>
        {% endif %}
        {% if app.user %}
            <a href="{{ path('profil') }}" class="pseudo" title="Mon compte">{{ app.user.pseudo }}</a>
            <a href="{{ path('app_logout') }}">Déconnexion</a>
        {% else %}
            <a href="{{ path('app_login') }}">Connexion</a>
            <a href="{{ path('app_register') }}" class="btn btn-petit">Inscription</a>
        {% endif %}
    </nav>
</header>

{% if is_granted('ROLE_ADMIN') %}
    {% set maj = grimpanbloc_mise_a_jour() %}
    {% if maj and not (app.current_route starts with 'admin_mise_a_jour') %}
        <div class="bandeau-maj" role="status">
            GrimPanBloc {{ maj.version }} est disponible (version installée : {{ grimpanbloc_version() }}).
            <a href="{{ path('admin_mise_a_jour') }}">Voir la mise à jour</a>
        </div>
    {% endif %}
{% endif %}

<main class="contenu">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash flash-{{ type }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

<footer class="pied">GrimPanBloc {{ grimpanbloc_version() }}</footer>

{% block javascripts %}{% endblock %}
</body>
</html>
