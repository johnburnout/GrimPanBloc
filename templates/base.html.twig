<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}GrimpePan{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
<header class="entete">
    <a href="{{ path('app_home') }}" class="logo">Grimpe<span>Pan</span></a>
    <nav>
        <a href="{{ path('app_home') }}">Voies</a>
        <a href="{{ path('secteur_index') }}">Secteurs</a>
        {% if app.user %}
            <span class="pseudo">{{ app.user.pseudo }}</span>
            <a href="{{ path('app_logout') }}">Déconnexion</a>
        {% else %}
            <a href="{{ path('app_login') }}">Connexion</a>
            <a href="{{ path('app_register') }}" class="btn btn-petit">Inscription</a>
        {% endif %}
    </nav>
</header>

<main class="contenu">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash flash-{{ type }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

{% block javascripts %}{% endblock %}
</body>
</html>
