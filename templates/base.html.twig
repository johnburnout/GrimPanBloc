<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}GrimPanBloc{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('logo/favicon.svg') }}">
    <link rel="preload" href="{{ asset('fonts/bricolage-grotesque/bricolage-grotesque-latin-wght-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
<header class="entete">
    {# SVG insérés dans la page (et non en <img>) pour que le texte du logo
       utilise la police Bricolage Grotesque chargée par la page.
       Sur petit écran, le symbole seul laisse la place au menu. #}
    {% if club_logo() %}
        <img class="logo-club" src="{{ asset(club_logo()) }}" alt="{{ club_nom() ?: 'commun.logo_club'|trans }}">
    {% endif %}
    <a href="{{ path('app_home') }}" class="logo" aria-label="{{ 'nav.accueil'|trans }}">
        <span class="logo-complet">{{ source('@logo/logo-inverse.svg') }}</span>
        <span class="logo-symbole">{{ source('@logo/mark-inverse.svg') }}</span>
    </a>
    <nav>
        <a href="{{ path('app_home') }}">{{ 'nav.voies'|trans }}</a>
        <a href="{{ path('secteur_index') }}">{{ 'nav.secteurs'|trans }}</a>
        <a href="{{ path('informations') }}">{{ 'nav.infos'|trans }}</a>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin') }}">{{ 'nav.administration'|trans }}</a>
        {% endif %}
        {% if app.user %}
            <a href="{{ path('profil') }}" class="pseudo" title="{{ 'nav.mon_compte'|trans }}">{{ app.user.pseudo }}</a>
            {# POST + jeton CSRF : un site tiers ne peut pas déconnecter l'utilisateur à son insu #}
            <form method="post" action="{{ path('app_logout') }}" class="form-deconnexion">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                <button type="submit" class="btn-lien">{{ 'nav.deconnexion'|trans }}</button>
            </form>
        {% else %}
            <a href="{{ path('app_login') }}">{{ 'nav.connexion'|trans }}</a>
            <a href="{{ path('app_register') }}" class="btn btn-petit">{{ 'nav.inscription'|trans }}</a>
        {% endif %}
    </nav>
</header>

{% if is_granted('ROLE_ADMIN') %}
    {% set maj = grimpanbloc_mise_a_jour() %}
    {% if maj and not (app.current_route starts with 'admin_mise_a_jour') %}
        <div class="bandeau-maj" role="status">
            {{ 'maj.bandeau'|trans({version: maj.version, installee: grimpanbloc_version()}) }}
            <a href="{{ path('admin_mise_a_jour') }}">{{ 'maj.bandeau_lien'|trans }}</a>
        </div>
    {% endif %}
{% endif %}

<main class="contenu">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash flash-{{ type }}">{{ message|trans }}</div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

<footer class="pied">
    <span>GrimPanBloc {{ grimpanbloc_version() }}</span>
    {# Menu des langues (fait maison pour afficher les drapeaux partout) : <details> s'ouvre sans JavaScript #}
    {% set langueActuelle = app.request.locale %}
    <details class="langues">
        <summary aria-label="{{ 'pied.langue'|trans }} : {{ langues()[langueActuelle] }}">
            {{ langues()[langueActuelle] }} <img class="drapeau" src="{{ asset('drapeaux/' ~ langueActuelle ~ '.svg') }}" alt="" width="21" height="14">
        </summary>
        <ul>
            {% for code, nom in langues() %}
                <li><a href="{{ path('langue', {langue: code, retour: app.request.requestUri}) }}" lang="{{ code }}" hreflang="{{ code }}"
                       {% if code == langueActuelle %}aria-current="true"{% endif %}>{{ nom }} <img class="drapeau" src="{{ asset('drapeaux/' ~ code ~ '.svg') }}" alt="" width="21" height="14"></a></li>
            {% endfor %}
        </ul>
    </details>
</footer>

{# Textes des scripts (public/js/), dans la langue de la page #}
<script type="application/json" id="textes-js">{{ {
    plein_ecran: 'js.plein_ecran'|trans,
    quitter_plein_ecran: 'js.quitter_plein_ecran'|trans,
    zoom: 'js.zoom'|trans,
    zoomer: 'js.zoomer'|trans,
    dezoomer: 'js.dezoomer'|trans,
    niveau_zoom: 'js.niveau_zoom'|trans,
    voir_toute_photo: 'js.voir_toute_photo'|trans,
    deplier_barre: 'js.deplier_barre'|trans,
    replier_barre: 'js.replier_barre'|trans,
    photo_zone: 'js.photo_zone'|trans,
}|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_HEX_TAG'))|raw }}</script>
<script src="{{ asset('js/langues.js') }}" defer></script>
{% block javascripts %}{% endblock %}
</body>
</html>
