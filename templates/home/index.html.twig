{% extends 'base.html.twig' %}

{% block body %}
    {% set urlSite = url('app_home') %}
    <div class="titre-actions">
        <h1>{{ 'accueil.titre'|trans }}</h1>
        {# Partage d'un téléphone à l'autre : l'autre personne scanne le QR code #}
        <details class="partage">
            <summary class="btn btn-secondaire">{{ 'accueil.partager'|trans }}</summary>
            <div class="partage-contenu">
                <div class="qr">{{ qr_code_svg(urlSite) }}</div>
                <p class="partage-url">{{ urlSite }}</p>
                <p class="aide">{{ 'accueil.partager_aide'|trans }}</p>
            </div>
        </details>
    </div>

    {# Nouvelles photos proposées pour les voies du grimpeur connecté (voir Recalage) #}
    {% for p in propositionsPhoto %}
        <div class="flash flash-info alerte-photo">
            {{ 'accueil.photo_proposee'|trans({nom: p.voie.nom}) }}
            <a href="{{ path('voie_proposition_photo', {id: p.voie.id, recalage: p.recalage.id}) }}">{{ 'accueil.photo_proposee_lien'|trans }}</a>
        </div>
    {% endfor %}

    {{ include('voie/_explorateur.html.twig') }}
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/voies.js') }}" defer></script>
{% endblock %}
