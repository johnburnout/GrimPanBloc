{% extends 'base.html.twig' %}

{% block title %}Secteurs · GrimPanBloc{% endblock %}

{% block body %}
    <div class="titre-actions">
        <h1>Secteurs</h1>
        {% if is_granted('ROLE_USER') %}
            <a href="{{ path('secteur_new') }}" class="btn">+ Nouveau secteur</a>
        {% endif %}
    </div>

    {% if secteurs is empty %}
        <p class="vide">Aucun secteur. Commencez par en créer un (pan, mur, dévers…).</p>
    {% else %}
        <ul class="liste-secteurs">
            {% for ligne in secteurs %}
                {% set s = ligne.secteur %}
                <li>
                    <a href="{{ path('secteur_show', {id: s.id}) }}">
                        <strong>{{ s.nom }}</strong>
                        <small>{{ ligne.voies }} voie{{ ligne.voies > 1 ? 's' }}</small>
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
