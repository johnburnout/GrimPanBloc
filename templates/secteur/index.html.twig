{% extends 'base.html.twig' %}

{% block title %}{{ 'secteurs.titre'|trans }} · GrimPanBloc{% endblock %}

{% block body %}
    <div class="titre-actions">
        <h1>{{ 'secteurs.titre'|trans }}</h1>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('secteur_new') }}" class="btn">+ {{ 'secteurs.nouveau'|trans }}</a>
        {% endif %}
    </div>

    {% if secteurs is empty %}
        <p class="vide">{{ (is_granted('ROLE_ADMIN') ? 'secteurs.aucun_admin' : 'secteurs.aucun')|trans }}</p>
    {% else %}
        <ul class="liste-secteurs">
            {% for ligne in secteurs %}
                {% set s = ligne.secteur %}
                <li>
                    <a href="{{ path('secteur_show', {id: s.id}) }}">
                        <strong>{{ s.nom }}</strong>
                        <small>{{ 'voies.nombre'|trans({n: ligne.voies}) }}</small>
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
