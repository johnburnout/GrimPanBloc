{% extends 'base.html.twig' %}

{% block title %}{{ secteur.nom }} · GrimPanBloc{% endblock %}

{% block body %}
    <div class="titre-actions">
        <h1>{{ secteur.nom }}</h1>
        {% if is_granted('ROLE_USER') %}
            <a href="{{ path('voie_new', {id: secteur.id}) }}" class="btn">+ {{ 'voie.nouvelle'|trans }}</a>
        {% else %}
            <a href="{{ path('app_login') }}" class="btn btn-secondaire">{{ 'secteurs.connectez_vous'|trans }}</a>
        {% endif %}
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin_secteur_nettoyer', {id: secteur.id}) }}" class="btn btn-secondaire">{{ 'secteurs.nettoyer_ellipse'|trans }}</a>
            <a href="{{ path('admin_secteur_supprimer', {id: secteur.id}) }}" class="btn btn-secondaire">{{ 'secteurs.supprimer_ellipse'|trans }}</a>
        {% endif %}
    </div>

    {% if secteur.description %}<p>{{ secteur.description|nl2br }}</p>{% endif %}

    {{ include('voie/_explorateur.html.twig') }}
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/voies.js') }}" defer></script>
{% endblock %}
