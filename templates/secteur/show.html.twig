{% extends 'base.html.twig' %}

{% block title %}{{ secteur.nom }} · GrimPanBloc{% endblock %}

{% block body %}
    <div class="titre-actions">
        <h1>{{ secteur.nom }}</h1>
        {% if is_granted('ROLE_USER') %}
            <a href="{{ path('voie_new', {id: secteur.id}) }}" class="btn">+ Nouvelle voie</a>
        {% else %}
            <a href="{{ path('app_login') }}" class="btn btn-secondaire">Connectez-vous pour créer une voie</a>
        {% endif %}
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin_secteur_nettoyer', {id: secteur.id}) }}" class="btn btn-secondaire">Nettoyer le secteur…</a>
        {% endif %}
    </div>

    {% if secteur.description %}<p>{{ secteur.description|nl2br }}</p>{% endif %}

    {{ include('voie/_liste.html.twig') }}
{% endblock %}
