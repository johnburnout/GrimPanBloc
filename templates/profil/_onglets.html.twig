{# Onglets de l'espace personnel. Variable : actif ('profil' | 'croix' | 'voies') #}
<nav class="onglets" aria-label="{{ 'nav.mon_compte'|trans }}">
    <a href="{{ path('profil') }}" {{ actif == 'profil' ? 'aria-current="page"' }}>{{ 'profil.onglet_profil'|trans }}</a>
    <a href="{{ path('profil_croix') }}" {{ actif == 'croix' ? 'aria-current="page"' }}>{{ 'profil.onglet_croix'|trans }}</a>
    <a href="{{ path('profil_voies') }}" {{ actif == 'voies' ? 'aria-current="page"' }}>{{ 'profil.onglet_voies'|trans }}</a>
</nav>
