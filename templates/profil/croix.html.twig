{% extends 'base.html.twig' %}

{% block title %}{{ 'profil.onglet_croix'|trans }} · GrimPanBloc{% endblock %}

{% block body %}
    <h1>{{ 'nav.mon_compte'|trans }}</h1>
    {{ include('profil/_onglets.html.twig', {actif: 'croix'}) }}

    {% if croix is empty %}
        <p class="vide">{{ 'profil.aucune_croix'|trans }}</p>
    {% else %}
        <div class="tableau-defilant">
            <table class="tableau">
                <thead><tr><th>{{ 'profil.col_voie'|trans }}</th><th>{{ 'voies.tri.secteur'|trans }}</th><th>{{ 'profil.col_cotation_affichee'|trans }}</th><th>{{ 'voie.ma_cotation'|trans }}</th><th>{{ 'profil.col_le'|trans }}</th></tr></thead>
                <tbody>
                    {% for c in croix %}
                        {% set voie = c.voie %}
                        <tr>
                            <td><a href="{{ path('voie_show', {id: voie.id}) }}">{{ voie.nom }}</a></td>
                            <td>{{ voie.photo.secteur.nom }}</td>
                            <td>{{ include('voie/_badge.html.twig') }}</td>
                            <td>{{ c.cotation ? (voie.systeme.cotation(c.cotation) ?? c.cotation)|trans : (voie.auteur == app.user ? '— ' ~ 'profil.votre_voie'|trans : '—') }}</td>
                            <td>{{ c.creeLe|date('d/m/Y') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <p class="aide">{{ 'profil.croix_total'|trans({n: croix|length}) }}</p>
    {% endif %}
{% endblock %}
