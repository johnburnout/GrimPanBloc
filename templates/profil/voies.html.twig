{% extends 'base.html.twig' %}

{% block title %}{{ 'profil.onglet_voies'|trans }} · GrimPanBloc{% endblock %}

{% block body %}
    <h1>{{ 'nav.mon_compte'|trans }}</h1>
    {{ include('profil/_onglets.html.twig', {actif: 'voies'}) }}

    {% if voies is empty %}
        <p class="vide">{{ 'profil.aucune_voie'|trans }}</p>
    {% else %}
        {{ include('voie/_liste.html.twig') }}
    {% endif %}
{% endblock %}
