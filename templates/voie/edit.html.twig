{% extends 'base.html.twig' %}

{% block title %}{{ 'voie.modifier_nom'|trans({nom: voie.nom}) }} · GrimPanBloc{% endblock %}

{% block body %}
    <p class="fil"><a href="{{ path('voie_show', {id: voie.id}) }}">← {{ voie.nom }}</a></p>
    <h1>{{ 'voie.modifier_titre'|trans }}</h1>

    {% if trace %}
        {{ include('voie/_form.html.twig', {bouton: 'voie.form.enregistrer_modifications'}) }}
    {% else %}
        <div class="flash flash-info">
            {{ 'voie.verrouillee'|trans({grimpeurs: voie.croixValidantes|map(c => c.grimpeur.pseudo)|join(', ')}) }}
        </div>

        {{ include('voie/_photo.html.twig', {classe: 'grande'}) }}
        <p><a href="{{ path('voie_changer_photo', {id: voie.id}) }}" class="btn btn-secondaire">{{ 'voie.changer_photo'|trans }}</a></p>

        {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
        {{ form_errors(form) }}
        {{ form_row(form.nom) }}
        {{ form_row(form.description) }}
        <button type="submit" class="btn btn-grand">{{ 'voie.form.enregistrer_modifications'|trans }}</button>
        {{ form_end(form) }}
    {% endif %}
{% endblock %}

{% block javascripts %}
    {% if trace %}
        <script src="{{ asset('js/editeur.js') }}" defer></script>
    {% else %}
        <script src="{{ asset('js/visionneuse.js') }}" defer></script>
    {% endif %}
{% endblock %}
