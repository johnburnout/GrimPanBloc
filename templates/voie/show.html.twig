{% extends 'base.html.twig' %}

{% block title %}{{ voie.nom }} · GrimpePan{% endblock %}

{% block body %}
    <p class="fil"><a href="{{ path('secteur_show', {id: voie.photo.secteur.id}) }}">← {{ voie.photo.secteur.nom }}</a></p>

    <div class="titre-actions">
        <h1>{{ include('voie/_badge.html.twig') }} {{ voie.nom }}</h1>
        <div class="actions">
            {% if is_granted('VOIE_MODIFIER', voie) %}
                <a href="{{ path('voie_edit', {id: voie.id}) }}" class="btn btn-secondaire">Modifier</a>
            {% endif %}
            {% if voie.auteur == app.user or is_granted('ROLE_ADMIN') %}
                {% if voie.estValidee %}
                    <a href="#suppression" class="btn btn-danger">Supprimer…</a>
                {% else %}
                    <form method="post" action="{{ path('voie_delete', {id: voie.id}) }}"
                          onsubmit="return confirm('Supprimer cette voie ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('supprimer' ~ voie.id) }}">
                        <button class="btn btn-danger">Supprimer</button>
                    </form>
                {% endif %}
            {% endif %}
        </div>
    </div>

    {{ include('voie/_photo.html.twig', {classe: 'grande'}) }}

    <ul class="legende">
        <li><span class="pastille prise-depart"></span> Départ</li>
        <li><span class="pastille prise-main"></span> Main</li>
        <li><span class="pastille prise-pied"></span> Pied</li>
        <li><span class="pastille prise-top"></span> Top</li>
    </ul>

    {% if voie.description %}<p>{{ voie.description|nl2br }}</p>{% endif %}

    <p class="meta">
        {{ voie.systeme.libelle }} · ouverte par <strong>{{ voie.auteur.pseudo }}</strong>
        le {{ voie.creeLe|date('d/m/Y') }} · {{ voie.prises|length }} prise(s)
    </p>

    <section class="croix">
        {% set nb = voie.croix|length %}
        <p>
            {% if nb == 0 %}
                Personne n'a encore réussi cette voie.
            {% else %}
                ✔ Réussie par {{ voie.croix|map(c => c.grimpeur.pseudo)|join(', ') }}
            {% endif %}
        </p>
        {% if app.user %}
            {% set maCroix = voie.croixDe(app.user) %}
            <form method="post" action="{{ path('voie_croix', {id: voie.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('croix' ~ voie.id) }}">
                {% if maCroix %}
                    <button class="btn btn-secondaire">Retirer ma croix</button>
                {% else %}
                    <button class="btn">J'ai réussi cette voie</button>
                {% endif %}
            </form>
            {% if voie.auteur == app.user and not maCroix %}
                <p class="aide">Votre propre croix ne verrouille pas la voie : seule celle d'un autre grimpeur le fait.</p>
            {% endif %}
        {% endif %}
    </section>

    {% if voie.estValidee and (voie.auteur == app.user or is_granted('ROLE_ADMIN')) %}
        {% set mot = constant('App\\Controller\\VoieController::MOT_CONFIRMATION') %}
        <section id="suppression" class="zone-danger">
            <h2>Supprimer la voie</h2>
            <p>
                Cette voie a été réussie par {{ voie.croixValidantes|length }} autre(s) grimpeur(s).
                La supprimer effacera aussi {{ voie.croix|length }} croix. Cette action est définitive.
            </p>
            <form method="post" action="{{ path('voie_delete', {id: voie.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('supprimer' ~ voie.id) }}">
                <label for="confirmation">Tapez <strong>{{ mot }}</strong> pour confirmer</label>
                <input type="text" id="confirmation" name="confirmation" required
                       autocomplete="off" autocapitalize="characters" spellcheck="false"
                       pattern="\s*{{ mot }}\s*" title="Tapez {{ mot }} en majuscules">
                <button class="btn btn-danger">Supprimer définitivement</button>
            </form>
        </section>
    {% endif %}
{% endblock %}
