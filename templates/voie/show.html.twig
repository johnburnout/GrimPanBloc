{% extends 'base.html.twig' %}

{% block title %}{{ voie.nom }} · GrimPanBloc{% endblock %}

{% block body %}
    <p class="fil"><a href="{{ path('secteur_show', {id: voie.photo.secteur.id}) }}">← {{ voie.photo.secteur.nom }}</a></p>

    <div class="titre-actions">
        <h1>{{ include('voie/_badge.html.twig') }} {{ voie.nom }}</h1>
        <div class="actions">
            {% if is_granted('VOIE_MODIFIER', voie) %}
                <a href="{{ path('voie_edit', {id: voie.id}) }}" class="btn btn-secondaire">Modifier</a>
            {% endif %}
            {% if is_granted('VOIE_SUPPRIMER', voie) %}
                {% if voie.estValidee %}
                    <a href="#suppression" class="btn btn-danger">Supprimer…</a>
                {% else %}
                    <form method="post" action="{{ path('voie_delete', {id: voie.id}) }}"
                          onsubmit="return confirm('Supprimer cette voie ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('supprimer' ~ voie.id) }}">
                        <button class="btn btn-danger">Supprimer</button>
                    </form>
                {% endif %}
            {% endif %}
        </div>
    </div>

    {{ include('voie/_photo.html.twig', {classe: 'grande'}) }}

    <ul class="legende">
        <li><span class="pastille prise-depart"></span> Départ</li>
        <li><span class="pastille prise-main"></span> Main</li>
        <li><span class="pastille prise-pied"></span> Pied</li>
        <li><span class="pastille prise-top"></span> Top</li>
    </ul>

    {% if voie.description %}<p>{{ voie.description|nl2br }}</p>{% endif %}

    <p class="meta">
        {{ voie.systeme.libelle }} · ouverte par <strong>{{ voie.auteur.pseudo }}</strong>
        le {{ voie.creeLe|date('d/m/Y') }} · {{ voie.prises|length }} prise(s)
    </p>

    <section class="croix">
        <h2>Cotation</h2>
        {% set repartition = voie.repartitionCotations %}
        <p>
            {{ include('voie/_badge.html.twig') }}
            {% if repartition is empty %}
                proposée par {{ voie.auteur.pseudo }} (créateur). Elle sera remplacée par l'avis des grimpeurs qui réussiront la voie.
            {% else %}
                d'après {{ voie.votesCotation|length }} grimpeur(s) ayant réussi la voie
                · proposition du créateur : <strong>{{ voie.cotationAuteurEnum ? voie.cotationAuteurEnum.libelle : voie.cotationAuteur }}</strong>
            {% endif %}
        </p>
        {% if repartition is not empty %}
            <ul class="repartition" aria-label="Cotations proposées">
                {% for r in repartition %}
                    <li{% if r.cotation.value == voie.cotation %} class="retenue"{% endif %}>
                        <span class="badge badge-{{ voie.systeme.value }}" style="--couleur: {{ r.cotation.couleurBadge }}">{{ r.cotation.libelle }}</span>
                        × {{ r.nombre }}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        <h2>Réussites</h2>
        <p>
            {% if voie.croix is empty %}
                Personne n'a encore réussi cette voie.
            {% else %}
                ✔ {{ voie.croix|map(c => c.grimpeur.pseudo ~ (c.cotation ? ' (' ~ c.cotation ~ ')' : ''))|join(', ') }}
            {% endif %}
        </p>

        {% if app.user %}
            {% set maCroix = voie.croixDe(app.user) %}
            {% set estAuteur = voie.auteur == app.user %}
            <form method="post" action="{{ path('voie_croix', {id: voie.id}) }}" class="form-croix">
                <input type="hidden" name="_token" value="{{ csrf_token('croix' ~ voie.id) }}">
                {% if not estAuteur %}
                    {% set proposee = maCroix ? maCroix.cotation : voie.cotation %}
                    <label for="cotation-proposee">{{ maCroix ? 'Ma cotation' : 'Cotation que je propose' }}</label>
                    <select id="cotation-proposee" name="cotation" required>
                        {% for c in voie.systeme.cotations %}
                            <option value="{{ c.value }}" {{ c.value == proposee ? 'selected' }}>{{ c.libelle }}</option>
                        {% endfor %}
                    </select>
                {% endif %}
                {% if maCroix %}
                    {% if not estAuteur %}<button class="btn" name="action" value="modifier">Modifier ma cotation</button>{% endif %}
                    <button class="btn btn-secondaire" name="action" value="retirer">Retirer ma croix</button>
                {% else %}
                    <button class="btn" name="action" value="poser">J'ai réussi cette voie</button>
                {% endif %}
            </form>
            {% if estAuteur and not maCroix %}
                <p class="aide">Votre propre croix ne verrouille pas la voie et ne vote pas : seules celles des autres grimpeurs comptent.</p>
            {% endif %}
        {% endif %}
    </section>

    {% if voie.estValidee and is_granted('VOIE_SUPPRIMER', voie) %}
        {% set mot = constant('App\\Security\\ConfirmationSuppression::MOT') %}
        <section id="suppression" class="zone-danger">
            <h2>Supprimer la voie</h2>
            <p>
                Cette voie a été réussie par {{ voie.croixValidantes|length }} autre(s) grimpeur(s).
                La supprimer effacera aussi {{ voie.croix|length }} croix. Cette action est définitive.
            </p>
            <form method="post" action="{{ path('voie_delete', {id: voie.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('supprimer' ~ voie.id) }}">
                <label for="confirmation">Tapez <strong>{{ mot }}</strong> pour confirmer</label>
                <input type="text" id="confirmation" name="confirmation" required
                       autocomplete="off" autocapitalize="characters" spellcheck="false"
                       pattern="\s*{{ mot }}\s*" title="Tapez {{ mot }} en majuscules">
                <button class="btn btn-danger">Supprimer définitivement</button>
            </form>
        </section>
    {% endif %}
{% endblock %}
