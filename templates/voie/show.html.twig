{% extends 'base.html.twig' %}

{% block title %}{{ voie.nom }} · GrimPanBloc{% endblock %}

{% block body %}
    <p class="fil"><a href="{{ path('secteur_show', {id: voie.photo.secteur.id}) }}">← {{ voie.photo.secteur.nom }}</a></p>

    <div class="titre-actions">
        <h1>{{ include('voie/_badge.html.twig') }} {{ voie.nom }}</h1>
        <div class="actions">
            {% if is_granted('VOIE_MODIFIER', voie) %}
                <a href="{{ path('voie_edit', {id: voie.id}) }}" class="btn btn-secondaire">{{ 'voie.modifier'|trans }}</a>
            {% endif %}
            {% if is_granted('VOIE_DUPLIQUER', voie) %}
                <a href="{{ path('voie_dupliquer', {id: voie.id}) }}" class="btn btn-secondaire">{{ 'voie.dupliquer'|trans }}</a>
            {% endif %}
            {% if is_granted('VOIE_SUPPRIMER', voie) %}
                {% if voie.estValidee %}
                    <a href="#suppression" class="btn btn-danger">{{ 'voie.supprimer_ellipse'|trans }}</a>
                {% else %}
                    <form method="post" action="{{ path('voie_delete', {id: voie.id}) }}"
                          onsubmit="return confirm('{{ 'voie.supprimer_confirmer'|trans|e('js') }}')">
                        <input type="hidden" name="_token" value="{{ csrf_token('supprimer' ~ voie.id) }}">
                        <button class="btn btn-danger">{{ 'commun.supprimer'|trans }}</button>
                    </form>
                {% endif %}
            {% endif %}
        </div>
    </div>

    {{ include('voie/_photo.html.twig', {classe: 'grande'}) }}

    <ul class="legende">
        <li><span class="pastille prise-depart"></span> {{ 'enum.type_prise.depart'|trans }}</li>
        <li><span class="pastille prise-main"></span> {{ 'enum.type_prise.main'|trans }}</li>
        {% if not voie.piedsLibres %}<li><span class="pastille prise-pied"></span> {{ 'enum.type_prise.pied'|trans }}</li>{% endif %}
        <li><span class="pastille prise-top"></span> {{ 'enum.type_prise.top'|trans }}</li>
    </ul>

    {% if voie.description %}<p>{{ voie.description|nl2br }}</p>{% endif %}

    <p class="meta">
        {{ voie.systeme|trans }} · <strong>{{ (voie.piedsLibres ? 'voie.pieds_libres' : 'voie.pieds_imposes')|trans }}</strong>
        · {{ 'voie.ouverte_par'|trans({pseudo: '<strong>' ~ voie.auteur.pseudo|e ~ '</strong>', date: voie.creeLe|date('d/m/Y')})|raw }}
        · {{ 'voie.nombre_prises'|trans({n: voie.prisesAffichees|length}) }}
    </p>

    <section class="croix">
        <h2>{{ 'voie.cotation'|trans }}</h2>
        {% set repartition = voie.repartitionCotations %}
        <p>
            {{ include('voie/_badge.html.twig') }}
            {% if repartition is empty %}
                {{ 'voie.cotation_proposee_par'|trans({pseudo: voie.auteur.pseudo}) }}
            {% else %}
                {{ 'voie.cotation_d_apres'|trans({n: voie.votesCotation|length}) }}
                · {{ 'voie.proposition_createur'|trans }} <strong>{{ voie.cotationAuteurEnum ? voie.cotationAuteurEnum|trans : voie.cotationAuteur }}</strong>
            {% endif %}
        </p>
        {% if repartition is not empty %}
            <ul class="repartition" aria-label="{{ 'voie.cotations_proposees'|trans }}">
                {% for r in repartition %}
                    <li{% if r.cotation.value == voie.cotation %} class="retenue"{% endif %}>
                        <span class="badge badge-{{ voie.systeme.value }}" style="--couleur: {{ r.cotation.couleurBadge }}">{{ r.cotation|trans }}</span>
                        × {{ r.nombre }}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        <h2>{{ 'voie.reussites'|trans }}</h2>
        <p>
            {% if voie.croix is empty %}
                {{ 'voie.personne'|trans }}
            {% else %}
                ✔ {{ voie.croix|map(c => c.grimpeur.pseudo ~ (c.cotation ? ' (' ~ ((voie.systeme.cotation(c.cotation) ?? c.cotation)|trans) ~ ')' : ''))|join(', ') }}
            {% endif %}
        </p>

        {% if app.user %}
            {% set maCroix = voie.croixDe(app.user) %}
            {% set estAuteur = voie.auteur == app.user %}
            <form method="post" action="{{ path('voie_croix', {id: voie.id}) }}" class="form-croix">
                <input type="hidden" name="_token" value="{{ csrf_token('croix' ~ voie.id) }}">
                {% if not estAuteur %}
                    {% set proposee = maCroix ? maCroix.cotation : voie.cotation %}
                    <label for="cotation-proposee">{{ (maCroix ? 'voie.ma_cotation' : 'voie.cotation_que_je_propose')|trans }}</label>
                    <select id="cotation-proposee" name="cotation" required>
                        {% for c in voie.systeme.cotations %}
                            <option value="{{ c.value }}" {{ c.value == proposee ? 'selected' }}>{{ c|trans }}</option>
                        {% endfor %}
                    </select>
                {% endif %}
                {% if maCroix %}
                    {% if not estAuteur %}<button class="btn" name="action" value="modifier">{{ 'voie.modifier_ma_cotation'|trans }}</button>{% endif %}
                    <button class="btn btn-secondaire" name="action" value="retirer">{{ 'voie.retirer_croix'|trans }}</button>
                {% else %}
                    <button class="btn" name="action" value="poser">{{ 'voie.j_ai_reussi'|trans }}</button>
                {% endif %}
            </form>
            {% if estAuteur and not maCroix %}
                <p class="aide">{{ 'voie.propre_croix'|trans }}</p>
            {% endif %}
        {% endif %}
    </section>

    {% if voie.estValidee and is_granted('VOIE_SUPPRIMER', voie) %}
        {% set mot = 'confirmation.supprimer'|trans %}
        <section id="suppression" class="zone-danger">
            <h2>{{ 'voie.supprimer_titre'|trans }}</h2>
            <p>{{ 'voie.supprimer_validee'|trans({autres: voie.croixValidantes|length, croix: voie.croix|length}) }}</p>
            <form method="post" action="{{ path('voie_delete', {id: voie.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('supprimer' ~ voie.id) }}">
                {{ include('_confirmation.html.twig') }}
                <button class="btn btn-danger">{{ 'confirmation.supprimer_definitivement'|trans }}</button>
            </form>
        </section>
    {% endif %}
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/visionneuse.js') }}" defer></script>
{% endblock %}
