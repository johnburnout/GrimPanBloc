{# Grille de cartes de voies. Variable : voies #}
{% if voies is empty %}
    <p class="vide">Aucune voie pour le moment.</p>
{% else %}
    <ul class="grille-voies">
        {% for voie in voies %}
            <li class="carte-voie">
                <a href="{{ path('voie_show', {id: voie.id}) }}">
                    {{ include('voie/_photo.html.twig', {voie: voie, classe: 'miniature'}) }}
                    <div class="carte-infos">
                        {{ include('voie/_badge.html.twig', {voie: voie}) }}
                        <strong>{{ voie.nom }}</strong>
                        <small>{{ voie.photo.secteur.nom }} · {{ voie.auteur.pseudo }}</small>
                    </div>
                </a>
            </li>
        {% endfor %}
    </ul>
{% endif %}
