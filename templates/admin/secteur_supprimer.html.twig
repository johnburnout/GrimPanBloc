{% extends 'base.html.twig' %}

{% block title %}{{ 'supprimer_secteur.titre_court'|trans({nom: secteur.nom}) }} · {{ 'nav.administration'|trans }} · GrimPanBloc{% endblock %}

{% block body %}
    <p class="fil"><a href="{{ path('secteur_show', {id: secteur.id}) }}">← {{ secteur.nom }}</a></p>
    <h1>{{ 'supprimer_secteur.titre'|trans({nom: secteur.nom}) }}</h1>

    <section class="zone-danger">
        <ul>
            <li>{{ 'supprimer_secteur.disparait'|trans({nom: '<strong>' ~ secteur.nom|e ~ '</strong>'})|raw }}</li>
            {% if contenu.voies > 0 %}
                <li>{{ 'supprimer_secteur.voies'|trans({voies: contenu.voies, croix: contenu.croix}) }}</li>
            {% endif %}
            {% if contenu.photos > 0 %}
                <li>{{ 'supprimer_secteur.photos'|trans({photos: contenu.photos}) }}</li>
            {% endif %}
            <li>{{ 'secteur.sauvegarde_avant'|trans({lien: '<a href="' ~ path('admin_sauvegardes') ~ '">' ~ 'admin.onglet.sauvegardes'|trans ~ '</a>'})|raw }}</li>
        </ul>
        {% set mot = 'confirmation.supprimer'|trans %}
        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('supprimer-secteur' ~ secteur.id) }}">
            {{ include('_confirmation.html.twig') }}
            <button class="btn btn-danger">{{ 'supprimer_secteur.bouton'|trans }}</button>
        </form>
    </section>
{% endblock %}
