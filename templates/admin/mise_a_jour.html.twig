{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.onglet.mise_a_jour'|trans }} · GrimPanBloc{% endblock %}

{% block body %}
    <h1>{{ 'nav.administration'|trans }}</h1>
    {{ include('admin/_onglets.html.twig', {actif: 'mise_a_jour'}) }}

    {% set journal = app.session.get('mise_a_jour_dernier_journal') %}
    {% if journal %}
        <section class="carte-form-large">
            <h2>{{ 'maj.derniere'|trans }}</h2>
            <ol class="journal">{% for ligne in journal %}<li>{{ ligne|trans }}</li>{% endfor %}</ol>
        </section>
        {% do app.session.remove('mise_a_jour_dernier_journal') %}
    {% endif %}

    <section class="carte-form-large">
        <p>{{ 'maj.version_installee'|trans }} <strong>{{ versionInstallee }}</strong></p>

        {% if release is null %}
            <p class="aide">{{ 'maj.inconnue'|trans }}</p>
        {% elseif not disponible %}
            <p class="flash flash-success">{{ 'maj.a_jour'|trans({version: release.version}) }}</p>
        {% else %}
            <p class="flash flash-info">
                {{ (release.publieeLe ? 'maj.disponible_le' : 'maj.disponible')|trans({version: '<strong>' ~ release.version|e ~ '</strong>', date: release.publieeLe ? release.publieeLe|date('d/m/Y') : ''})|raw }}
            </p>

            {% if release.notes %}
                <h2>{{ 'maj.nouveautes'|trans }}</h2>
                <div class="notes-version">{{ release.notes|nl2br }}</div>
            {% endif %}
            <p><a href="{{ release.url }}" rel="noopener" target="_blank">{{ 'maj.voir_github'|trans }} ↗</a></p>

            {% if not release.estInstallable %}
                <p class="flash flash-error">{{ 'maj.pas_installable'|trans }}</p>
            {% elseif problemes is not empty %}
                <div class="flash flash-error">
                    <p>{{ 'maj.impossible_navigateur'|trans }}</p>
                    <ul>{% for p in problemes %}<li>{{ p|trans }}</li>{% endfor %}</ul>
                    <p>{{ 'maj.en_ssh'|trans }} <code>php bin/console app:mise-a-jour</code></p>
                </div>
            {% else %}
                <h2>{{ 'maj.installer'|trans }}</h2>
                <ul class="aide">
                    <li>{{ 'maj.point1'|trans }}</li>
                    <li>{{ 'maj.point2'|trans({fichier: '<code>.env.local</code>'})|raw }}</li>
                    <li>{{ 'maj.point3'|trans({dossier: '<code>var/mise-a-jour/</code>'})|raw }}</li>
                    <li>{{ 'maj.point4'|trans({outil: '<code>mariadb-dump</code>'})|raw }}</li>
                </ul>
                {# data-turbo="false" : la réponse est une page (envoi du jeton), pas une redirection #}
                <form method="post" action="{{ path('admin_mise_a_jour_installer') }}" data-turbo="false"
                      onsubmit="this.querySelector('button').disabled = true; this.querySelector('button').textContent = '{{ 'maj.en_cours'|trans|e('js')|e('html_attr') }}'">
                    <input type="hidden" name="_token" value="{{ csrf_token('mise_a_jour') }}">
                    <button class="btn">{{ 'maj.mettre_a_jour'|trans({version: release.version}) }}</button>
                </form>
            {% endif %}
        {% endif %}

        <p class="meta"><a href="{{ path('admin_mise_a_jour', {verifier: 1}) }}">{{ 'maj.verifier'|trans }}</a>
            {{ 'maj.verifier_aide'|trans }}</p>
    </section>
{% endblock %}
