{% extends 'base.html.twig' %}

{% block title %}{{ 'nettoyer.titre_court'|trans({nom: secteur.nom}) }} · {{ 'nav.administration'|trans }} · GrimPanBloc{% endblock %}

{% block body %}
    <p class="fil"><a href="{{ path('secteur_show', {id: secteur.id}) }}">← {{ secteur.nom }}</a></p>
    <h1>{{ 'nettoyer.titre'|trans({nom: secteur.nom}) }}</h1>

    <section class="zone-danger">
        {% if contenu.voies == 0 and contenu.photos == 0 %}
            <p>{{ 'nettoyer.vide'|trans }}</p>
        {% else %}
            <ul>
                <li>{{ 'nettoyer.voies'|trans({voies: contenu.voies, croix: contenu.croix}) }}</li>
                <li>{{ 'nettoyer.photos'|trans({photos: contenu.photos}) }}</li>
                <li>{{ 'nettoyer.conserve'|trans }}</li>
                <li>{{ 'secteur.sauvegarde_avant'|trans({lien: '<a href="' ~ path('admin_sauvegardes') ~ '">' ~ 'admin.onglet.sauvegardes'|trans ~ '</a>'})|raw }}</li>
            </ul>
            {% set mot = 'confirmation.supprimer'|trans %}
            <form method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('nettoyer' ~ secteur.id) }}">
                {{ include('_confirmation.html.twig') }}
                <button class="btn btn-danger">{{ 'nettoyer.bouton'|trans }}</button>
            </form>
        {% endif %}
    </section>
{% endblock %}
