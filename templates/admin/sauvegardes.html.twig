{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.onglet.sauvegardes'|trans }} · {{ 'nav.administration'|trans }} · GrimPanBloc{% endblock %}

{% block body %}
    <h1>{{ 'nav.administration'|trans }}</h1>
    {{ include('admin/_onglets.html.twig', {actif: 'sauvegardes'}) }}

    <p class="aide">{{ 'sauvegardes.aide'|trans }}</p>

    <section class="carte-form-large">
        <h2>{{ 'sauvegardes.nouvelle'|trans }}</h2>
        <form method="post" action="{{ path('admin_sauvegarde_creer') }}" class="form-en-ligne">
            <input type="hidden" name="_token" value="{{ csrf_token('sauvegarde_creer') }}">
            <label for="motif">{{ 'sauvegardes.note'|trans }}</label>
            <input type="text" id="motif" name="motif" maxlength="200" placeholder="{{ 'sauvegardes.note_exemple'|trans }}">
            <button class="btn">{{ 'sauvegardes.sauvegarder'|trans }}</button>
        </form>
    </section>

    <section class="carte-form-large">
        <h2>{{ 'sauvegardes.enregistrees'|trans }}</h2>
        {% if lignes is empty %}
            <p class="vide">{{ 'sauvegardes.aucune'|trans }}</p>
        {% else %}
            <p class="meta">{{ 'sauvegardes.total'|trans({n: lignes|length, taille: (tailleTotale / 1048576)|nombre(1)}) }}</p>
            <div class="tableau-defilant">
                <table class="tableau tableau-sauvegardes">
                    <thead>
                        <tr><th>{{ 'sauvegardes.col_date'|trans }}</th><th>{{ 'sauvegardes.col_type'|trans }}</th><th>{{ 'sauvegardes.col_contenu'|trans }}</th><th>{{ 'sauvegardes.col_taille'|trans }}</th><th>{{ 'commun.actions'|trans }}</th></tr>
                    </thead>
                    <tbody>
                        {% for l in lignes %}
                            {% set s = l.sauvegarde %}
                            {% set r = l.resume %}
                            <tr>
                                <td>{{ s.creeLe|date('d/m/Y H:i') }}</td>
                                <td>{{ s.type|trans }}{% if r and r.motif %}<br><small>{{ r.motif }}</small>{% endif %}</td>
                                <td>
                                    {% if r %}
                                        {{ 'sauvegardes.contenu'|trans({secteurs: r.secteurs|length, voies: r.nombreVoies, photos: r.nombrePhotos}) }}
                                        <br><small>{{ 'sauvegardes.version'|trans({version: r.version}) }}</small>
                                    {% else %}
                                        <span class="erreur">{{ 'sauvegardes.illisible'|trans({erreur: l.erreur|trans}) }}</span>
                                    {% endif %}
                                </td>
                                <td>{{ 'sauvegardes.mo'|trans({taille: (s.taille / 1048576)|nombre(1)}) }}</td>
                                <td class="actions-ligne">
                                    <a class="btn btn-petit btn-secondaire" href="{{ path('admin_sauvegarde_telecharger', {nom: s.nom}) }}" download>{{ 'sauvegardes.telecharger'|trans }}</a>
                                    {% if r %}<a class="btn btn-petit" href="{{ path('admin_sauvegarde_restaurer', {nom: s.nom}) }}">{{ 'sauvegardes.restaurer_ellipse'|trans }}</a>{% endif %}
                                    <form method="post" action="{{ path('admin_sauvegarde_supprimer', {nom: s.nom}) }}"
                                          onsubmit="return confirm('{{ 'sauvegardes.confirmer_suppression'|trans({date: s.creeLe|date('d/m/Y H:i')})|e('js') }}')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('supprimer' ~ s.nom) }}">
                                        <button class="btn btn-petit btn-danger">{{ 'commun.supprimer'|trans }}</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
        <p class="aide">{{ 'sauvegardes.emplacement'|trans({dossier: '<code>var/sauvegardes/</code>'})|raw }}</p>
    </section>

    <section class="carte-form-large">
        <h2>{{ 'sauvegardes.conservees'|trans }}</h2>
        <p class="aide">{{ 'sauvegardes.conservees_aide'|trans }}</p>
        {{ form_start(conservation, {attr: {class: 'form-en-ligne'}}) }}
            {{ form_errors(conservation) }}
            {{ form_label(conservation.automatiques, 'sauvegardes.nombre', {label_translation_parameters: {min: constant('App\\Sauvegarde\\ReglageSauvegardes::MIN'), max: constant('App\\Sauvegarde\\ReglageSauvegardes::MAX')}}) }}
            {{ form_widget(conservation.automatiques) }}
            <button class="btn">{{ 'commun.enregistrer'|trans }}</button>
            {{ form_errors(conservation.automatiques) }}
        {{ form_end(conservation) }}
    </section>

    <section class="carte-form-large">
        <h2>{{ 'sauvegardes.importer_titre'|trans }}</h2>
        <p class="aide">{{ 'sauvegardes.importer_aide'|trans({taille: tailleEnvoiMax}) }}</p>
        {{ form_start(import) }}
            {{ form_errors(import) }}
            {{ form_label(import.archive, 'sauvegardes.archive') }}
            {{ form_errors(import.archive) }}
            {{ form_widget(import.archive, {attr: {accept: '.zip,application/zip'}}) }}
            <button class="btn">{{ 'sauvegardes.importer'|trans }}</button>
        {{ form_end(import) }}
    </section>
{% endblock %}
