{% extends 'base.html.twig' %}

{% block title %}{{ 'restaurer.titre_page'|trans }} · {{ 'nav.administration'|trans }} · GrimPanBloc{% endblock %}

{% block body %}
    <p class="fil"><a href="{{ path('admin_sauvegardes') }}">← {{ 'admin.onglet.sauvegardes'|trans }}</a></p>
    <h1>{{ 'restaurer.titre'|trans({date: resume.creeLe|date('d/m/Y'), heure: resume.creeLe|date('H:i')}) }}</h1>
    <p class="meta">{{ sauvegarde.type|trans }}{% if resume.motif %} · {{ resume.motif }}{% endif %} · {{ 'sauvegardes.version'|trans({version: resume.version}) }}</p>

    <section class="zone-danger">
        <ul>
            <li>{{ 'restaurer.point1'|trans }}</li>
            <li>{{ 'restaurer.point2'|trans }}</li>
            <li>{{ 'restaurer.point3'|trans }}</li>
        </ul>

        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('restaurer' ~ sauvegarde.nom) }}">

            <fieldset class="choix">
                <legend>{{ 'restaurer.quoi'|trans }}</legend>
                <label class="case">
                    <input type="radio" name="portee" value="tout" required>
                    <span><strong>{{ 'restaurer.tous'|trans }}</strong> ({{ 'sauvegardes.contenu'|trans({secteurs: resume.secteurs|length, voies: resume.nombreVoies, photos: resume.nombrePhotos}) }}) :
                        {{ 'restaurer.tous_effet'|trans }}</span>
                </label>
                {% for s in resume.secteurs %}
                    <label class="case">
                        <input type="radio" name="portee" value="{{ s.id }}" required>
                        <span>{{ 'restaurer.seulement'|trans({nom: '<strong>' ~ s.nom|e ~ '</strong>'})|raw }} ({{ 'restaurer.contenu_secteur'|trans({voies: s.voies, photos: s.photos}) }}) :
                            {% if existants[s.id] is defined %}
                                {{ 'restaurer.remplace'|trans({nom: existants[s.id]}) }}
                            {% else %}
                                {{ 'restaurer.recree'|trans }}
                            {% endif %}</span>
                    </label>
                {% endfor %}
            </fieldset>

            {% if sauvegarde.type.value == 'manuelle' %}
                <fieldset class="choix">
                    <legend>{{ 'restaurer.apres'|trans }}</legend>
                    <label class="case"><input type="radio" name="apres" value="garder" required> {{ 'restaurer.gardee'|trans }}</label>
                    <label class="case"><input type="radio" name="apres" value="supprimer" required> {{ 'restaurer.supprimee'|trans }}</label>
                </fieldset>
            {% endif %}

            {{ include('_confirmation.html.twig', {mot: 'confirmation.restaurer'|trans}) }}
            <button class="btn btn-danger">{{ 'restaurer.bouton'|trans }}</button>
        </form>
    </section>
{% endblock %}
