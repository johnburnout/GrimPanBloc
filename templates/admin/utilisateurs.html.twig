{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.onglet.utilisateurs'|trans }} · {{ 'nav.administration'|trans }} · GrimPanBloc{% endblock %}

{% block body %}
    <h1>{{ 'nav.administration'|trans }}</h1>
    {{ include('admin/_onglets.html.twig', {actif: 'utilisateurs'}) }}

    <div class="tableau-defilant">
        <table class="tableau">
            <thead>
                <tr><th>{{ 'commun.pseudo'|trans }}</th><th>{{ 'commun.email'|trans }}</th><th>{{ 'profil.inscrit_le'|trans }}</th><th>{{ 'nav.voies'|trans }}</th><th>{{ 'utilisateurs.croix'|trans }}</th><th>{{ 'utilisateurs.statut'|trans }}</th><th>{{ 'commun.actions'|trans }}</th></tr>
            </thead>
            <tbody>
                {% for l in lignes %}
                    {% set u = l.utilisateur %}
                    {% set moi = u == app.user %}
                    <tr class="{{ u.estSupprime ? 'supprime' : (not u.actif ? 'inactif') }}">
                        <td><strong>{{ u.pseudo }}</strong>{% if moi %} <small>{{ 'utilisateurs.vous'|trans }}</small>{% endif %}</td>
                        <td>{{ u.estSupprime ? '—' : u.email }}</td>
                        <td>{{ u.creeLe|date('d/m/Y') }}</td>
                        <td>{{ l.voies }}</td>
                        <td>{{ l.croix }}</td>
                        <td>
                            {% if u.estSupprime %}{{ 'utilisateurs.supprime_le'|trans({date: u.supprimeLe|date('d/m/Y')}) }}
                            {% elseif not u.actif %}{{ 'utilisateurs.desactive'|trans }}
                            {% else %}{{ 'utilisateurs.actif'|trans }}{% if u.admin %} · <strong>{{ 'utilisateurs.admin'|trans }}</strong>{% endif %}{% endif %}
                        </td>
                        <td class="actions-ligne">
                            {% if not u.estSupprime %}
                                {% set jeton = csrf_token('utilisateur' ~ u.id) %}
                                <form method="post" action="{{ path('admin_utilisateur_admin', {id: u.id}) }}">
                                    <input type="hidden" name="_token" value="{{ jeton }}">
                                    <button class="btn btn-petit btn-secondaire">{{ (u.admin ? 'utilisateurs.retirer_admin' : 'utilisateurs.nommer_admin')|trans }}</button>
                                </form>
                                {% if not moi %}
                                    <form method="post" action="{{ path('admin_utilisateur_actif', {id: u.id}) }}">
                                        <input type="hidden" name="_token" value="{{ jeton }}">
                                        <button class="btn btn-petit btn-secondaire">{{ (u.actif ? 'utilisateurs.desactiver' : 'utilisateurs.reactiver')|trans }}</button>
                                    </form>
                                    <a class="btn btn-petit btn-danger" href="{{ path('admin_utilisateur_supprimer', {id: u.id}) }}">{{ 'voie.supprimer_ellipse'|trans }}</a>
                                {% endif %}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <p class="aide">{{ 'utilisateurs.aide'|trans }}</p>
{% endblock %}
