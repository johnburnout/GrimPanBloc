{# Onglets de l'administration. Variable : actif ('reglages' | 'utilisateurs' | 'photos' | 'sauvegardes' | 'fiche' | 'mise_a_jour') #}
<nav class="onglets" aria-label="{{ 'nav.administration'|trans }}">
    {% for cle, onglet in {
        reglages: {route: 'admin_reglages', libelle: 'admin.onglet.reglages'},
        utilisateurs: {route: 'admin_utilisateurs', libelle: 'admin.onglet.utilisateurs'},
        photos: {route: 'admin_photos', libelle: 'admin.onglet.photos'},
        sauvegardes: {route: 'admin_sauvegardes', libelle: 'admin.onglet.sauvegardes'},
        fiche: {route: 'admin_fiche', libelle: 'admin.onglet.fiche'},
        mise_a_jour: {route: 'admin_mise_a_jour', libelle: 'admin.onglet.mise_a_jour'},
    } %}
        <a href="{{ path(onglet.route) }}" {{ cle == actif ? 'aria-current="page"' }}>{{ onglet.libelle|trans }}</a>
    {% endfor %}
</nav>
