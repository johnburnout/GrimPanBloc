{% extends 'base.html.twig' %}

{% block title %}{{ 'utilisateurs.supprimer_titre'|trans({pseudo: cible.pseudo}) }} · {{ 'nav.administration'|trans }} · GrimPanBloc{% endblock %}

{% block body %}
    <p class="fil"><a href="{{ path('admin_utilisateurs') }}">← {{ 'admin.onglet.utilisateurs'|trans }}</a></p>
    <h1>{{ 'utilisateurs.supprimer_titre'|trans({pseudo: cible.pseudo}) }}</h1>

    <section class="zone-danger">
        <ul>
            <li>{{ 'utilisateurs.supprimer_email'|trans({email: cible.email}) }}</li>
            <li>{{ 'utilisateurs.supprimer_voies'|trans({voies: ligne ? ligne.voies : 0, croix: ligne ? ligne.croix : 0, pseudo: cible.pseudo}) }}</li>
            <li>{{ 'utilisateurs.supprimer_pseudo'|trans }}</li>
        </ul>
        {% set mot = 'confirmation.supprimer'|trans %}
        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('utilisateur' ~ cible.id) }}">
            {{ include('_confirmation.html.twig') }}
            <button class="btn btn-danger">{{ 'confirmation.supprimer_definitivement'|trans }}</button>
        </form>
    </section>
{% endblock %}
