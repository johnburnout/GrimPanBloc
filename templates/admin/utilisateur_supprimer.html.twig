{% extends 'base.html.twig' %}

{% block title %}Supprimer {{ cible.pseudo }} · Administration · GrimPanBloc{% endblock %}

{% block body %}
    <p class="fil"><a href="{{ path('admin_utilisateurs') }}">← Utilisateurs</a></p>
    <h1>Supprimer le compte de {{ cible.pseudo }}</h1>

    <section class="zone-danger">
        <ul>
            <li>L'email ({{ cible.email }}) et le mot de passe sont effacés : la personne ne pourra plus se connecter.</li>
            <li>Ses {{ ligne ? ligne.voies : 0 }} voie(s) et ses {{ ligne ? ligne.croix : 0 }} croix restent visibles sous le pseudo « {{ cible.pseudo }} ». Seul un administrateur pourra supprimer ces voies.</li>
            <li>Le pseudo reste réservé. Cette action est définitive.</li>
        </ul>
        {% set mot = constant('App\\Controller\\VoieController::MOT_CONFIRMATION') %}
        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('utilisateur' ~ cible.id) }}">
            <label for="confirmation">Tapez <strong>{{ mot }}</strong> pour confirmer</label>
            <input type="text" id="confirmation" name="confirmation" required autocomplete="off" autocapitalize="characters" spellcheck="false"
                   pattern="\s*{{ mot }}\s*" title="Tapez {{ mot }} en majuscules">
            <button class="btn btn-danger">Supprimer définitivement</button>
        </form>
    </section>
{% endblock %}
