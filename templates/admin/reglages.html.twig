{% extends 'base.html.twig' %}

{% block title %}Réglages · Administration · GrimPanBloc{% endblock %}

{% block body %}
    <h1>Administration</h1>
    {{ include('admin/_onglets.html.twig', {actif: 'reglages'}) }}

    <section class="carte-form-large">
        <h2>Sécurité de la connexion</h2>
        {% if not enHttps %}
            <p class="flash flash-error">Cette page est ouverte en <strong>HTTP</strong> : les mots de passe circulent en clair.
                Ouvrez-la en <a href="https://{{ app.request.httpHost }}{{ path('admin_reglages') }}">HTTPS</a> pour activer la redirection.</p>
        {% endif %}
        {{ form_start(https) }}
            {{ form_errors(https) }}
            <label class="case">
                {{ form_widget(https.forcer_https, {attr: {disabled: not enHttps and not forcerHttps}}) }}
                Toujours utiliser HTTPS : les visiteurs arrivant en <code>http://</code> sont redirigés vers <code>https://</code>
            </label>
            <p class="aide">À n'activer que si le certificat HTTPS est en place et renouvelé automatiquement (c'est le cas chez la plupart des hébergeurs, avec Let's Encrypt).
                Les navigateurs retiennent ce choix pendant 30 jours.</p>
            <button class="btn">Enregistrer</button>
        {{ form_end(https) }}
    </section>

    <section class="carte-form-large">
        <h2>Identité de la salle ou du club</h2>
        <p class="aide">Le logo s'affiche dans l'en-tête du site et sur la <a href="{{ path('admin_fiche') }}">fiche à imprimer</a>. PNG, JPEG ou WebP, 5 Mo au plus. Il est réduit à {{ constant('App\\Site\\IdentiteClub::COTE_MAX_LOGO') }} px.</p>
        {{ form_start(club) }}
            {{ form_errors(club) }}
            {{ form_label(club.nom_club, 'Nom de la salle ou du club') }}
            {{ form_errors(club.nom_club) }}
            {{ form_widget(club.nom_club, {attr: {maxlength: 100, placeholder: 'Périgord Escalade — Veyrignac'}}) }}
            {% if clubLogo %}
                <p class="apercu-logo"><img src="{{ asset(clubLogo) }}" alt="Logo actuel"></p>
                <label class="case">{{ form_widget(club.supprimer_logo) }} Supprimer le logo</label>
            {% else %}
                {% do club.supprimer_logo.setRendered %}
            {% endif %}
            {{ form_label(club.logo, clubLogo ? 'Remplacer le logo' : 'Logo') }}
            {{ form_errors(club.logo) }}
            {{ form_widget(club.logo, {attr: {accept: 'image/png,image/jpeg,image/webp'}}) }}
            <button class="btn">Enregistrer</button>
        {{ form_end(club) }}
    </section>

    <section class="carte-form-large">
        <h2>Serveur d'envoi des mails (SMTP)</h2>
        <p class="aide">Les informations sont fournies par votre hébergeur ou votre messagerie. Le mot de passe est enregistré chiffré.</p>
        {{ form_start(smtp, {attr: {autocomplete: 'off', class: 'grille-form'}}) }}
            {{ form_errors(smtp) }}
            <div class="ligne-form">
                <div>{{ form_label(smtp.hote, 'Serveur') }}{{ form_errors(smtp.hote) }}{{ form_widget(smtp.hote, {attr: {placeholder: 'smtp.exemple.org'}}) }}</div>
                <div class="etroit">{{ form_label(smtp.port, 'Port') }}{{ form_errors(smtp.port) }}{{ form_widget(smtp.port, {type: 'number', attr: {min: 1, max: 65535}}) }}</div>
            </div>
            {{ form_label(smtp.chiffrement, 'Chiffrement') }}
            {{ form_errors(smtp.chiffrement) }}
            {{ form_widget(smtp.chiffrement) }}
            <div class="ligne-form">
                <div>{{ form_label(smtp.utilisateur, 'Identifiant') }}{{ form_widget(smtp.utilisateur, {attr: {autocomplete: 'off'}}) }}</div>
                <div>
                    <label for="{{ smtp.mot_de_passe.vars.id }}">Mot de passe {% if smtpDefini %}<small>(enregistré : laissez vide pour le garder)</small>{% endif %}</label>
                    {{ form_widget(smtp.mot_de_passe, {attr: {autocomplete: 'new-password'}}) }}
                </div>
            </div>
            {% if smtpDefini %}
                <label class="case">{{ form_widget(smtp.effacer_mot_de_passe) }} Effacer le mot de passe enregistré</label>
            {% else %}
                {% do smtp.effacer_mot_de_passe.setRendered %}
            {% endif %}
            <div class="ligne-form">
                <div>{{ form_label(smtp.expediteur, 'Adresse d\'expédition') }}{{ form_errors(smtp.expediteur) }}{{ form_widget(smtp.expediteur, {attr: {placeholder: 'contact@exemple.org'}}) }}</div>
                <div>{{ form_label(smtp.expediteur_nom, 'Nom d\'expéditeur') }}{{ form_widget(smtp.expediteur_nom) }}</div>
            </div>
            <button class="btn">Enregistrer</button>
        {{ form_end(smtp) }}
    </section>

    <section class="carte-form-large">
        <h2>Mail de test</h2>
        {% if not smtpConfigure %}<p class="flash flash-info">Renseignez d'abord le serveur et l'adresse d'expédition.</p>{% endif %}
        <p class="aide">Envoie un message générique pour vérifier les réglages ci-dessus.</p>
        {{ form_start(mail_test, {attr: {class: 'form-en-ligne'}}) }}
            {{ form_errors(mail_test) }}
            {{ form_label(mail_test.destinataire, 'Destinataire') }}
            {{ form_widget(mail_test.destinataire) }}
            <button class="btn" {{ not smtpConfigure ? 'disabled' }}>Envoyer le mail de test</button>
            {{ form_errors(mail_test.destinataire) }}
        {{ form_end(mail_test) }}
    </section>

    <section class="carte-form-large">
        <h2>Envoyer un message</h2>
        <p class="aide">Un mail est envoyé à chaque destinataire : les adresses ne sont pas visibles des autres. Écrivez <code>{pseudo}</code> pour insérer le pseudo du destinataire. Les comptes désactivés ou supprimés ne reçoivent rien.</p>
        {{ form_start(envoi_groupe, {attr: {onsubmit: "return confirm('Envoyer ce message ?')"}}) }}
            {{ form_errors(envoi_groupe) }}
            <fieldset class="choix">
                <legend>Destinataires</legend>
                {% set libelles = {tous: 'Tous les utilisateurs (' ~ nbTous ~ ')', admins: 'Les administrateurs (' ~ nbAdmins ~ ')'} %}
                {% for choix in envoi_groupe.cible %}
                    <label class="case">{{ form_widget(choix) }} {{ libelles[choix.vars.value] }}</label>
                {% endfor %}
                {{ form_errors(envoi_groupe.cible) }}
            </fieldset>
            {{ form_label(envoi_groupe.objet, 'Objet') }}
            {{ form_errors(envoi_groupe.objet) }}
            {{ form_widget(envoi_groupe.objet, {attr: {maxlength: constant('App\\Form\\Reglages\\EnvoiGroupeType::LONGUEUR_MAX_OBJET')}}) }}
            {{ form_label(envoi_groupe.corps, 'Message') }}
            {{ form_errors(envoi_groupe.corps) }}
            {{ form_widget(envoi_groupe.corps, {attr: {rows: 8}}) }}
            <button class="btn" {{ not smtpConfigure ? 'disabled' }}>Envoyer</button>
        {{ form_end(envoi_groupe) }}
    </section>
{% endblock %}
